;;; lisp-fixture.el --- Behavioral oracle fixture -*- lexical-binding: t -*-
(require 'unii-memory)
(require 'json)
(let* ((input (json-parse-string (with-temp-buffer (insert-file-contents (getenv "UNII_ORACLE_INPUT")) (buffer-string)) :object-type 'plist :array-type 'list))
       (directory (make-temp-file "unii-ts-oracle-" t))
       (requests nil)
       (backend (list :start (lambda (request _emit done)
                              (push (list :node (vconcat (plist-get request :node)) :source (plist-get request :source) :context (plist-get request :context)) requests)
                              (let ((timer (run-at-time 0 nil
                                                       (lambda ()
                                                         (let* ((node (plist-get request :node)) (level (car node)) (index (cadr node)))
                                                           (funcall done (list :text (concat (format "user: synthetic %d/%d " level index) (make-string 300 ?s)))))))))
                                (lambda () (cancel-timer timer))))))
       (policy '(:view-high 2400 :view-low 1200 :compaction-high 600 :compaction-low 300))
       (memory (unii-memory-open directory :backend backend :policy policy)) traces receipts)
  (cl-labels ((snapshot (view)
                (let ((s (unii-memory-snapshot memory :view view)))
                  (list :state (symbol-name (plist-get s :state)) :before (plist-get s :before)
                        :coveredThrough (plist-get s :covered-through)
                        :view (vconcat (mapcar #'vconcat (plist-get s :view))) :text (plist-get s :text) :bytes (plist-get s :bytes)))))
    (unwind-protect
        (progn
          (cl-loop for record in (plist-get input :records) for i from 0 do
                   (let ((r (unii-memory-append memory record)))
                     (push (list :firstId (plist-get r :first-id) :ids (vconcat (plist-get r :ids)) :endExclusive (plist-get r :end-exclusive)) receipts))
                   (unii-memory-step memory)
                   (while (or (> (plist-get (unii-memory-inspect memory 'status) :active) 0)
                              (not (eq (plist-get (unii-memory-snapshot memory) :state) 'ready)))
                     (accept-process-output nil 0.001) (unii-memory-step memory))
                   (unii-memory-step memory)
                   (while (> (plist-get (unii-memory-inspect memory 'status) :active) 0)
                     (accept-process-output nil 0.001) (unii-memory-step memory))
                   (push (list :main (snapshot 'main) :compaction (snapshot 'compaction)) traces)
                   (when (= i 63)
                     (unii-memory-close memory)
                     (setq memory (unii-memory-open directory :backend backend :policy policy))))
          (let* ((count (plist-get (unii-memory-inspect memory 'status) :count))
                 (nodes (cl-loop for level from 0 to (logb count) append
                                 (cl-loop for index from 0 below (/ count (ash 1 level))
                                          for node = (unii-memory-inspect memory (list :kind 'node :id (* index (ash 1 level)) :n (ash 1 level)))
                                          when node collect (list :level level :index index :text (plist-get node :text))))))
            (princ (decode-coding-string
                    (json-serialize (list :traces (vconcat (nreverse traces)) :receipts (vconcat (nreverse receipts))
                                          :requests (vconcat (nreverse requests)) :nodes (vconcat nodes))) 'utf-8-unix))))
      (unii-memory-close memory) (delete-directory directory t))))
