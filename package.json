{
  "name": "@firfi/unii",
  "version": "0.1.0",
  "description": "Independent UNII memory core with caller-owned compression and storage",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/dearlordylord/unii.git" },
  "homepage": "https://github.com/dearlordylord/unii#readme",
  "bugs": { "url": "https://github.com/dearlordylord/unii/issues" },
  "author": {
    "name": "Igor Loskutov",
    "email": "igor.loskutoff@gmail.com",
    "url": "https://github.com/dearlordylord"
  },
  "contributors": [
    { "name": "Jonas Silva", "url": "https://github.com/jonaslsaa" }
  ],
  "keywords": ["unii", "memory", "llm", "summarization", "typescript"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "spec",
    "docs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:oracle": "tsx scripts/lisp-oracle.ts",
    "test:package": "node scripts/package-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run test:oracle && npm run build && npm run test:package",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "fast-check": "^4.0.0"
  }
}
